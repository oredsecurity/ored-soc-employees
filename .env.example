# ORED AI SOC Employees - Full Stack Environment
# Copy to .env and fill in your values: cp .env.example .env
# Keep this file out of screenshots and support tickets after filling secrets.

# -- Compose Project ------------------------------------------------------
# Use a unique value per tenant when several stacks share one Docker host.
COMPOSE_PROJECT_NAME=ored-soc

# -- Wazuh API Connection -------------------------------------------------
WAZUH_HOST=https://your-wazuh-manager
WAZUH_PORT=55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=
WAZUH_VERIFY_SSL=false

# -- Wazuh Indexer (optional, for vulnerability tools on Wazuh 4.8+) ------
WAZUH_INDEXER_HOST=
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASS=

# -- MCP Server -----------------------------------------------------------
LOG_LEVEL=INFO
MCP_AUTH_MODE=none
MCP_AUTH_SECRET_KEY=

# -- Alert Polling --------------------------------------------------------
ORED_POLL_ENABLED=true
ORED_POLL_INTERVAL=60
ORED_POLL_MIN_LEVEL=5
ORED_POLL_BATCH_SIZE=100

# -- Hermes Agent ---------------------------------------------------------
# Pin builds to a known Hermes release/ref for reproducibility.
HERMES_REF=v2026.5.16
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M2.7
LLM_BASE_URL=
LLM_API_KEY=

# -- Telegram Approval/Chat Interface ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=
